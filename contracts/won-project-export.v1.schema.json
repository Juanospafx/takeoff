{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brightronix.com/schemas/contracts/won-project-export.v1.schema.json",
  "title": "WonProjectExport.v1",
  "description": "Contrato estricto para el evento de exportacion de proyecto ganado desde Takeoff hacia Electroplan, ClockinAPP e Inventory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "occurred_at",
    "source_system",
    "source_project_id",
    "source_bid_id",
    "source_estimate_id",
    "idempotency_key",
    "correlation_id",
    "traceability",
    "approved_estimate",
    "project",
    "commercial_summary",
    "materials_snapshot",
    "documents_manifest"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_system": {
      "type": "string",
      "enum": ["takeoff"]
    },
    "source_project_id": {
      "type": "string",
      "minLength": 1
    },
    "source_bid_id": {
      "type": "string",
      "minLength": 1
    },
    "source_estimate_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "correlation_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["awarded_by"],
      "properties": {
        "awarded_by": {
          "type": "object",
          "additionalProperties": false,
          "required": ["user_id", "email", "display_name"],
          "properties": {
            "user_id": {
              "type": "string",
              "minLength": 1
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "display_name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "approved_estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimate_id",
        "estimate_number",
        "revision",
        "approved_at",
        "approved_by_user_id",
        "checksum_sha256",
        "currency",
        "total_amount",
        "total_labor_hours"
      ],
      "properties": {
        "estimate_id": {
          "type": "string",
          "minLength": 1
        },
        "estimate_number": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "approved_by_user_id": {
          "type": "string",
          "minLength": 1
        },
        "checksum_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "total_amount": {
          "type": "number",
          "minimum": 0
        },
        "total_labor_hours": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "name",
        "client",
        "location",
        "dates",
        "assigned_roles"
      ],
      "properties": {
        "number": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "client": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "client_id",
            "name",
            "contact_name",
            "contact_email",
            "contact_phone"
          ],
          "properties": {
            "client_id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "contact_name": {
              "type": "string",
              "minLength": 1
            },
            "contact_email": {
              "type": "string",
              "format": "email"
            },
            "contact_phone": {
              "type": "string",
              "minLength": 5
            }
          }
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "address_line1",
            "city",
            "state",
            "postal_code",
            "country",
            "latitude",
            "longitude",
            "geofence_radius_meters"
          ],
          "properties": {
            "address_line1": {
              "type": "string",
              "minLength": 1
            },
            "address_line2": {
              "type": "string"
            },
            "city": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "type": "string",
              "minLength": 1
            },
            "postal_code": {
              "type": "string",
              "minLength": 1
            },
            "country": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "geofence_radius_meters": {
              "type": "number",
              "minimum": 10,
              "maximum": 50000
            }
          }
        },
        "dates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "estimated_start_date",
            "estimated_completion_date"
          ],
          "properties": {
            "estimated_start_date": {
              "type": "string",
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "estimated_completion_date": {
              "type": "string",
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        },
        "assigned_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "user_id", "name", "email"],
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "project_manager",
                  "lead_electrician",
                  "estimator",
                  "supervisor"
                ]
              },
              "user_id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "email": {
                "type": "string",
                "format": "email"
              }
            }
          }
        }
      }
    },
    "commercial_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "total_amount",
        "total_labor_hours",
        "estimate_revision",
        "approved_estimate_hash"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "total_amount": {
          "type": "number",
          "minimum": 0
        },
        "total_labor_hours": {
          "type": "number",
          "minimum": 0
        },
        "estimate_revision": {
          "type": "string",
          "minLength": 1
        },
        "approved_estimate_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "materials_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "version",
        "generated_at",
        "total_items",
        "items"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "total_items": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item_id",
              "item_code",
              "description",
              "category",
              "quantity",
              "unit_of_measure"
            ],
            "properties": {
              "item_id": {
                "type": "string",
                "minLength": 1
              },
              "item_code": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "quantity": {
                "type": "number",
                "minimum": 0
              },
              "unit_of_measure": {
                "type": "string",
                "minLength": 1
              },
              "unit_cost": {
                "type": "number",
                "minimum": 0
              },
              "total_cost": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "documents_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_version",
        "total_files",
        "documents"
      ],
      "properties": {
        "manifest_version": {
          "type": "string",
          "minLength": 1
        },
        "total_files": {
          "type": "integer",
          "minimum": 0
        },
        "documents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "document_id",
              "file_name",
              "document_type",
              "content_type",
              "size_bytes",
              "checksum",
              "download_url"
            ],
            "properties": {
              "document_id": {
                "type": "string",
                "minLength": 1
              },
              "file_name": {
                "type": "string",
                "minLength": 1
              },
              "document_type": {
                "type": "string",
                "enum": [
                  "drawings",
                  "specifications",
                  "proposal",
                  "contract",
                  "boq_export",
                  "permit",
                  "other"
                ]
              },
              "content_type": {
                "type": "string",
                "minLength": 1
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "checksum": {
                "type": "object",
                "additionalProperties": false,
                "required": ["algorithm", "value"],
                "properties": {
                  "algorithm": {
                    "type": "string",
                    "enum": ["sha256"]
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              "download_url": {
                "type": "string",
                "pattern": "^(https?://[a-zA-Z0-9.-]+(:[0-9]+)?/|/api/)[^\\\\\\s]+$",
                "description": "Endpoint seguro para transferencia API o HTTPS. Quedan expresamente prohibidas rutas locales de archivo o protocolos de archivo."
              }
            }
          }
        }
      }
    }
  }
}
