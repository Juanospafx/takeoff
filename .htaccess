<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
</IfModule>

<IfModule mod_php.c>
    php_value upload_max_filesize 512M
    php_value post_max_size 512M
    php_value memory_limit 512M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 512M
    php_value post_max_size 512M
    php_value memory_limit 512M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 512M
    php_value post_max_size 512M
    php_value memory_limit 512M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>

<IfModule mod_rewrite.c>

    # Root domain: open the PDF/uploads Takeoff entry point.
    RewriteCond %{REQUEST_URI} ^/$
    RewriteRule ^$ /pages/takeoff.php [L]

    # The old pages directory/login entry must open Takeoff now.
    RewriteRule ^pages/?$ /pages/takeoff.php [L]
    RewriteRule ^pages/(login|logout|index)\.php$ /pages/takeoff.php [L]

    # Keep existing PHP pages, APIs, assets and uploads reachable.
    RewriteCond %{REQUEST_URI} ^/(pages|api|assets|uploads|views|core|funciones|docs)/ [NC]
    RewriteRule .* - [L]

    # Serve real files and directories normally.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule .* - [L]

    # Fallback to the Takeoff entry point instead of login/frontend.
    RewriteRule ^.*$ /pages/takeoff.php [L]
</IfModule>
