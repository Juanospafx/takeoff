<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Root domain: open the current Takeoff workspace.
    RewriteCond %{REQUEST_URI} ^/$
    RewriteRule ^$ /pages/takeoff_layers.php [L]

    # The old pages directory/login entry must open Takeoff now.
    RewriteRule ^pages/?$ /pages/takeoff_layers.php [L]
    RewriteRule ^pages/(login|logout|index)\.php$ /pages/takeoff_layers.php [L]

    # Keep existing PHP pages, APIs, assets and uploads reachable.
    RewriteCond %{REQUEST_URI} ^/(pages|api|assets|uploads|views|core|funciones|docs)/ [NC]
    RewriteRule .* - [L]

    # Serve real files and directories normally.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule .* - [L]

    # Fallback to the Takeoff module instead of login/frontend.
    RewriteRule ^.*$ /pages/takeoff_layers.php [L]
</IfModule>
