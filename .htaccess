<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
</IfModule>

<IfModule mod_php.c>
    php_value upload_max_filesize 10240M
    php_value post_max_size 10300M
    php_value memory_limit 512M
    php_value max_execution_time 3600
    php_value max_input_time 3600
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 10240M
    php_value post_max_size 10300M
    php_value memory_limit 512M
    php_value max_execution_time 3600
    php_value max_input_time 3600
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 10240M
    php_value post_max_size 10300M
    php_value memory_limit 512M
    php_value max_execution_time 3600
    php_value max_input_time 3600
</IfModule>

<IfModule mod_rewrite.c>

    # Prevent direct access to source, diagnostics, test data and local tooling.
    RewriteRule ^(?:core|config|db|docs|tests|bin|scratch|contracts|\.claude|\.agents)(?:/|$) - [F,L,NC]
    RewriteRule (?:^|/)(?:\.env(?:\..*)?|composer\.(?:json|lock)|.*\.(?:sql|bak|ini|log))$ - [F,L,NC]

    # Uploaded documents are delivered only after the session guard succeeds.
    RewriteRule ^uploads/(.+)$ api/download.php?scope=uploads&path=$1 [QSA,L,NE]
    RewriteRule ^api/uploads/(.+)$ api/download.php?scope=api_uploads&path=$1 [QSA,L,NE]

    # Root domain: open the PDF/uploads Takeoff entry point.
    RewriteCond %{REQUEST_URI} ^/$
    RewriteRule ^$ /pages/takeoff.php [L]

    # The old pages directory and index entry open Takeoff.
    RewriteRule ^pages/?$ /pages/takeoff.php [L]
    RewriteRule ^pages/index\.php$ /pages/takeoff.php [L]

    # Keep public application entry points and static assets reachable.
    RewriteCond %{REQUEST_URI} ^/(pages|api|assets|views|funciones|admin)/ [NC]
    RewriteRule .* - [L]

    # Serve real files and directories normally.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule .* - [L]

    # Fallback to the Takeoff entry point instead of login/frontend.
    RewriteRule ^.*$ /pages/takeoff.php [L]
</IfModule>
